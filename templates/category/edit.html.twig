{% extends 'base_dashboard.html.twig' %}

{% block title %}Edit Category - VeraBelle Collection{% endblock %}
{% block page_title %}Edit Category{% endblock %}

{% block content %}
<style>
    .edit-category-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 150px);
        background: linear-gradient(135deg, #fafafa, #fefefe);
        font-family: 'Poppins', sans-serif;
        padding: 40px 0;
    }

    .edit-category-card {
        width: 100%;
        max-width: 600px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        padding: 50px 40px;
        transition: all 0.3s ease;
    }

    .edit-category-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(168, 188, 161, 0.25);
    }

    .edit-category-title {
        font-size: 26px;
        font-weight: 600;
        color: #2c3e50;
        text-align: center;
        margin-bottom: 35px;
        position: relative;
    }

    .edit-category-title::after {
        content: '';
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #A8BCA1, #F4C2C2);
        display: block;
        margin: 10px auto 0;
        border-radius: 2px;
    }

    label {
        display: block;
        font-weight: 500;
        color: #2c3e50;
        font-size: 14px;
        margin-bottom: 8px;
    }

    input, textarea, select {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 14px;
        color: #2c3e50;
        outline: none;
        background-color: #fafafa;
        transition: all 0.3s ease;
    }

    input:focus, textarea:focus, select:focus {
        border-color: #A8BCA1;
        background-color: #fff;
    }

    .btn-update {
        display: block;
        width: 100%;
        padding: 12px 25px;
        border-radius: 10px;
        background: linear-gradient(135deg, #A8BCA1, #8FAF8F);
        color: #fff;
        border: none;
        font-weight: 500;
        cursor: pointer;
        margin-top: 20px;
        transition: all 0.3s ease;
    }

    .btn-update:hover {
        box-shadow: 0 6px 18px rgba(168, 188, 161, 0.4);
        transform: translateY(-2px);
    }

    .form-actions {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    .btn-back {
        background: #f4f4f4;
        color: #2c3e50;
        border: 1px solid #ddd;
        padding: 12px 25px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 500;
        transition: 0.3s;
    }

    .btn-back:hover {
        background: #eaeaea;
    }
</style>

<div class="edit-category-wrapper">
    <div class="edit-category-card">
        <div class="edit-category-title">Edit Category</div>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn-update">{{ button_label|default('Update') }}</button>
        {{ form_end(form) }}

        <div class="form-actions">
            <a href="{{ path('app_category_index') }}" class="btn-back">← Back to List</a>
        </div>
    </div>
</div>
{% endblock %}
